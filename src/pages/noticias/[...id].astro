---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { foto } from '../../lib/imagens';
import { imagemPartilha, migalhas, referenciaOrganizacao } from '../../lib/seo';
import CartaoNoticia from '../../components/CartaoNoticia.astro';
import Partilhar from '../../components/Partilhar.astro';
import { dataLonga, isoDia, noticias } from '../../lib/conteudo';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.rascunho);
  return noticias.map((noticia) => ({ params: { id: noticia.id }, props: { noticia } }));
}

const { noticia } = Astro.props;
const { titulo, data, resumo, imagem, imagem_descricao } = noticia.data;
const capa = foto(imagem);
const urlPagina = new URL(Astro.url.pathname, Astro.site).href;
const dados = [
  {
    '@type': 'NewsArticle',
    '@id': `${urlPagina}#noticia`,
    headline: titulo,
    ...(resumo && { description: resumo }),
    datePublished: data.toISOString(),
    dateModified: data.toISOString(),
    image: [await imagemPartilha(capa)],
    author: referenciaOrganizacao,
    publisher: referenciaOrganizacao,
    mainEntityOfPage: urlPagina,
    inLanguage: 'pt-PT',
  },
  migalhas([
    ['Início', '/'],
    ['Notícias', '/noticias/'],
    [titulo, Astro.url.pathname],
  ]),
];
const { Content } = await render(noticia);
const outras = (await noticias()).filter((n) => n.id !== noticia.id).slice(0, 3);
---

<Base
  titulo={titulo}
  descricao={resumo}
  tipo="article"
  publicado={data}
  imagem={capa}
  imagemDescricao={imagem_descricao}
  dados={dados}
>
  <article>
    <header class="topo-pagina">
      <div class="contentor">
        <a class="voltar" href="/noticias/">← Notícias</a>
        <time class="etiqueta" datetime={isoDia(data)}>{dataLonga(data)}</time>
        <h1>{titulo}</h1>
        {resumo && <p>{resumo}</p>}
      </div>
    </header>

    <div class="contentor seccao">
      <div class="texto">
        {capa && <Image class="capa" src={capa} alt={imagem_descricao ?? ''} widths={[600, 900, 1400]} sizes="(max-width: 860px) 100vw, 760px" loading="eager" />}
        <Content />
        <Partilhar titulo={titulo} url={urlPagina} />
      </div>
    </div>
  </article>

  {
    outras.length > 0 && (
      <section class="seccao contentor mais">
        <h2>Mais notícias</h2>
        <div class="grelha">
          {outras.map((n) => (
            <CartaoNoticia noticia={n} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .voltar {
    display: block;
    width: fit-content;
    margin-bottom: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .topo-pagina h1 {
    max-width: 28ch;
    margin-top: 0.3rem;
    font-size: clamp(1.6rem, 3.6vw, 2.6rem);
  }

  .texto {
    margin-inline: auto;
  }

  .capa {
    margin-top: 0 !important;
  }

  .mais {
    border-top: 1px solid var(--linha);
  }
</style>
