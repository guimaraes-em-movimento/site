---
import Base from '../layouts/Base.astro';
---

<Base titulo="Contactos" descricao="Como contactar a Associação Guimarães em Movimento.">
  <header class="topo-pagina">
    <div class="contentor">
      <span class="etiqueta">Fale connosco</span>
      <h1>Contactos</h1>
      <p>Para informações sobre eventos, parcerias, voluntariado ou imprensa, escreva-nos.</p>
    </div>
  </header>

  <section class="seccao contentor">
    <a class="contacto" href="mailto:geral@guimaraesemmovimento.pt">
      <span class="etiqueta">Email</span>
      <span class="contacto__email">geral@guimaraesemmovimento.pt</span>
    </a>
  </section>
</Base>

<style>
  .contacto {
    display: grid;
    gap: 0.4rem;
    max-width: 560px;
    padding: 2rem;
    border-radius: var(--raio);
    background: var(--superficie);
    border: 1px solid var(--linha);
    box-shadow: var(--sombra);
    text-decoration: none;
    transition: transform 0.18s ease;
  }

  .contacto:hover {
    transform: translateY(-2px);
  }

  .contacto__email {
    font-size: clamp(1.15rem, 3.5vw, 1.6rem);
    font-weight: 800;
    color: var(--verde);
    overflow-wrap: anywhere;
  }

</style>
