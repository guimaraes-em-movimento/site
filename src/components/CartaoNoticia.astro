---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { dataLonga, isoDia } from '../lib/conteudo';
import { foto } from '../lib/imagens';

interface Props {
  noticia: CollectionEntry<'noticias'>;
  /** Cartão grande, na horizontal, para a notícia mais recente. */
  destaque?: boolean;
}

const { noticia, destaque = false } = Astro.props;
const { titulo, data, resumo, imagem, imagem_descricao } = noticia.data;
const capa = foto(imagem);
---

<article class:list={["cartao", { "cartao--destaque": destaque }]}>
  <div class="cartao__imagem">
    {
      capa ? (
        <Image
          src={capa}
          alt={imagem_descricao ?? ''}
          widths={destaque ? [400, 800, 1200] : [400, 800]}
          sizes={destaque ? '(max-width: 760px) 100vw, 620px' : '(max-width: 720px) 100vw, 380px'}
          loading={destaque ? 'eager' : 'lazy'}
        />
      ) : (
        <div class="cartao__sem-imagem" aria-hidden="true">
          <img src="/marca.svg" alt="" />
        </div>
      )
    }
  </div>
  <div class="cartao__corpo">
    <time class="etiqueta" datetime={isoDia(data)}>{dataLonga(data)}</time>
    <h3><a href={`/noticias/${noticia.id}/`}>{titulo}</a></h3>
    {resumo && <p>{resumo}</p>}
  </div>
</article>

<style>
  .cartao {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--superficie);
    border: 1px solid var(--linha);
    border-radius: var(--raio);
    overflow: hidden;
    box-shadow: var(--sombra);
    transition: transform 0.18s ease;
  }

  .cartao:hover {
    transform: translateY(-3px);
  }

  .cartao__imagem {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--verde);
  }

  .cartao__imagem > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cartao__sem-imagem {
    height: 100%;
    display: grid;
    place-items: center;
    background:
      radial-gradient(circle at 80% 20%, rgb(217 169 63 / 0.25), transparent 55%),
      linear-gradient(135deg, var(--verde) 0%, var(--verde-escuro) 100%);
  }

  .cartao__sem-imagem img {
    width: 45%;
    filter: brightness(0) invert(1);
    opacity: 0.18;
  }

  .cartao__corpo {
    padding: 1.25rem 1.35rem 1.5rem;
  }

  .cartao h3 {
    margin: 0.35rem 0 0.5rem;
  }

  .cartao h3 a {
    color: var(--verde);
    text-decoration: none;
  }

  /* O cartão inteiro é clicável */
  .cartao h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .cartao--destaque {
    grid-column: 1 / -1;
  }

  @media (min-width: 760px) {
    .cartao--destaque {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
    }

    .cartao--destaque .cartao__imagem {
      aspect-ratio: auto;
      min-height: 100%;
    }

    .cartao--destaque .cartao__corpo {
      align-self: center;
      padding: clamp(1.75rem, 3.5vw, 3rem);
    }

    .cartao--destaque h3 {
      font-size: clamp(1.4rem, 2.4vw, 1.9rem);
      line-height: 1.2;
    }

    .cartao--destaque p {
      font-size: 1.05rem;
      -webkit-line-clamp: 4;
    }
  }

  .cartao p {
    margin: 0;
    color: var(--texto-suave);
    font-size: 0.97rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
