---
import '@fontsource/montserrat/400.css';
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';
import { NOME, imagemPartilha, organizacao, website } from '../lib/seo';

interface Props {
  titulo?: string;
  /** Título completo da página, quando não deve seguir o padrão "Página · Associação". */
  tituloCompleto?: string;
  descricao?: string;
  /** Fotografia mostrada quando a página é partilhada (WhatsApp, Facebook…). Sem foto, usa o logótipo. */
  imagem?: ImageMetadata;
  imagemDescricao?: string;
  tipo?: 'website' | 'article';
  publicado?: Date;
  /** Dados estruturados próprios da página (evento, notícia, migalhas). */
  dados?: object[];
  semIndexar?: boolean;
}

const {
  titulo,
  tituloCompleto,
  descricao = 'A Associação Guimarães em Movimento promove, organiza e apoia eventos desportivos em Guimarães: provas de atletismo, corridas de estrada, corta-mato, caminhadas e marchas.',
  imagem,
  imagemDescricao,
  tipo = 'website',
  publicado,
  dados = [],
  semIndexar = false,
} = Astro.props;

const tituloPagina = tituloCompleto ?? (titulo ? `${titulo} · ${NOME}` : NOME);
const canonico = new URL(Astro.url.pathname, Astro.site);

const partilha = {
  url: await imagemPartilha(imagem),
  alt: imagem ? (imagemDescricao ?? titulo ?? NOME) : NOME,
};

const grafo = JSON.stringify({ '@context': 'https://schema.org', '@graph': [organizacao, website, ...dados] }).replace(
  /</g,
  '\\u003c',
);
---

<!doctype html>
<html lang="pt-PT">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    {semIndexar ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonico} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`Notícias · ${NOME}`} href="/noticias/rss.xml" />
    <meta name="theme-color" content="#014423" />

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_PT" />
    <meta property="og:site_name" content={NOME} />
    <meta property="og:title" content={titulo ?? NOME} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonico} />
    <meta property="og:image" content={partilha.url} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={partilha.alt} />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={grafo} />
  </head>
  <body>
    <a class="saltar" href="#conteudo">Saltar para o conteúdo</a>
    <Cabecalho />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
  </body>
</html>
